# Dockerfile.notebook
# Girder-free image for running Multi-Compartment Segmentation
# from a Jupyter notebook environment.
#
# Differences from Dockerfile:
#   - No girder-slicer-cli-web / girder-client / ctk-cli
#   - No slicer_cli_web entrypoint
#   - Installs JupyterLab
#   - Entrypoint: jupyter lab (bind to 0.0.0.0 so the host can reach it)

FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04
LABEL com.nvidia.volumes.needed="nvidia_driver"

LABEL maintainer="Anish Tatke - Sarder Lab. <anish.tatke@ufl.edu>"

RUN echo !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! STARTING NOTEBOOK BUILD !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Remove bad repos
RUN rm -f \
    /etc/apt/sources.list.d/cuda.list

# System deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates curl wget git unzip software-properties-common \
      build-essential make \
      libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
      libffi-dev liblzma-dev tk-dev \
      libncursesw5-dev xz-utils \
      libcurl4-openssl-dev libexpat1-dev libhdf5-dev \
      libxml2-dev libxslt1-dev \
      ffmpeg libsm6 libxext6 \
      libtool pkg-config autoconf automake cmake \
      libmemcached-dev memcached \
    && rm -rf /var/lib/apt/lists/*

# --- Install Python 3.12 via deadsnakes PPA ---
RUN add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      python3.12 python3.12-dev python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Expose Python 3.12 as default python/python3
RUN ln -sf /usr/bin/python3.12 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.12 /usr/bin/python && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    ln -sf /usr/local/bin/pip3.12 /usr/bin/pip3 && \
    ln -sf /usr/local/bin/pip3.12 /usr/bin/pip

RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

RUN which python && \
    python --version

ENV build_path=/opt/build

RUN apt-get update && \
    apt-get install -y --no-install-recommends memcached && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENV mc_path=/opt/MultiC
RUN mkdir -p $mc_path

COPY . $mc_path/
WORKDIR $mc_path

# PyTorch with CUDA 12.1 (same as Dockerfile)
RUN pip install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu121

# Detectron2 (same as Dockerfile)
RUN python -m pip install --no-cache-dir --no-build-isolation \
    "git+https://github.com/facebookresearch/detectron2.git"

RUN pip install --no-cache-dir tensorboard cmake onnx

# Install scientific deps WITHOUT Girder/CLI packages
RUN pip install --no-cache-dir -r requirements-notebook.txt

# Fix pkg_resources for Python 3.12 + detectron2 (mirrors original Dockerfile)
RUN pip install --no-cache-dir "setuptools<71"

RUN python --version && pip --version && pip freeze

# MultiCLocal.py uses sys.path.append('..') so it must run from multic/cli/.
# Adding multic/ to PYTHONPATH makes segmentationschool importable from there.
ENV PYTHONPATH=$mc_path/multic:$mc_path

# Expose JupyterLab port
EXPOSE 8888

# Working directory matches where MultiCLocal.py resolves its relative imports.
WORKDIR $mc_path/multic/cli

# CMD is used (not ENTRYPOINT) so it can be fully overridden by docker run.
# Default: start JupyterLab
#   docker run -p 8888:8888 <image>
# Run batch segmentation via MultiCLocal.py:
#   docker run <image> python MultiC/MultiCLocal.py \
#       --input_file /data/slide.svs \
#       --modelfile /data/model.pth \
#       --output_dir /data/output
CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root", "--NotebookApp.token=", "--NotebookApp.password="]
